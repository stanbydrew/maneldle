# Copiază fișierul în .env.local și completează valorile.
# Le găsești în dashboard-ul Supabase: Project Settings → API Keys / Data API.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Cheie secretă, cu acces total. Folosită DOAR pe server, nu o expune niciodată în browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Codul pe care îl dai pe grup ca să-și poată face cont.
INVITE_CODE=schimba-ma

# Ziua de start a jocului (YYYY-MM-DD). De aici se numără „zilele totale” din leaderboard.
LAUNCH_DATE=2026-12-01
